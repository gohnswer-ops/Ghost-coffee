{
  "version": 6,
  "description": "Ghost Caffee RTDB schema. Passwords are never stored here.",
  "paths": {
    "config/app": "Public app configuration",
    "config/ownerUid": "Immutable bootstrap owner UID",
    "usernames/{username}": "Lowercase username -> Firebase Auth UID; mutable only for incomplete-registration rollback",
    "users/{uid}": "Private account; registrationComplete gates finalization; role/status/coins/device/settings",
    "profiles/{uid}": "Public profile fields only",
    "presence/{uid}": "Online/last-seen state",
    "devices/{deviceId}/users/{uid}": "Soft device/account association",
    "userChats/{uid}/{chatId}": "Per-user authorized chat index",
    "chats/{chatId}": "Private/group chat metadata and participants",
    "messages/{chatId}/{messageId}": "Messages, delivery/read/reactions/starred/deletion flags",
    "typing/{chatId}/{uid}": "Ephemeral typing indicator",
    "stories/{storyId}": "24-hour story metadata (optional text preview; media remains in storyContents)",
    "storyViews/{storyId}/{uid}": "Story owner/admin view list",
    "storyViewedByUser/{uid}/{storyId}": "Viewer's read-state index",
    "notifications/{uid}/{notificationId}": "Private notifications",
    "followers/{uid}/{followerUid}": "Followers index",
    "following/{uid}/{targetUid}": "Following index",
    "reports/{reportId}": "Moderation reports",
    "walletTransactions/{uid}/{txnId}": "Admin coin adjustment ledger",
    "admin/auditLog/{logId}": "Moderation/admin audit trail",
    "admin/settings": "Staff-only administrative settings",
    "storyContents/{storyId}": "Private story content loaded only while the story is active or by staff",
    "stories/{storyId}/preview": "Short text-story fallback preview, max 600 chars",
    "chatRequests/{toUid}/{fromUid}": "Private message-request state",
    "chats/{chatId}/requestState": "Private chat request state",
    "chats/{chatId}/blocked/{uid}": "Permanent group ban",
    "chats/{chatId}/participants/{uid}/bannedUntil": "Temporary group ban expiry",
    "chats/{chatId}/participants/{uid}/banReason": "Temporary group ban reason",
    "chats/{chatId}/groupModerators/{uid}": "Group-scoped moderator assignment",
    "chats/{chatId}/inviteCode": "Permanent invite code",
    "chats/{chatId}/backgrounds/{uid}": "Per-user chat background",
    "storyReactions/{storyId}/{uid}": "Story reactions"
  },
  "schemaVersion": 11
}